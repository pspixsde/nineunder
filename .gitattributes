# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Source code
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.inl text eol=lf
*.slang text eol=lf
*.hlsl text eol=lf
*.glsl text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.editorconfig text eol=lf
*.clang-format text eol=lf
*.clang-tidy text eol=lf

# Scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

# Git LFS — binary assets
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
